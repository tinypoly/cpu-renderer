{
  "name": "@tinypoly/cpu-renderer",
  "version": "0.1.2",
  "description": "Software renderer for Three.js scenes: a multi-worker CPU rasterizer with a GLSL interpreter, BVH shadows, diffuse global illumination and denoising.",
  "keywords": [
    "three",
    "threejs",
    "renderer",
    "rasterizer",
    "cpu",
    "software-rendering",
    "global-illumination",
    "glsl",
    "web-worker"
  ],
  "license": "MIT",
  "author": "Danilo Gadelha",
  "homepage": "https://github.com/tinypoly/cpu-renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinypoly/cpu-renderer.git"
  },
  "bugs": "https://github.com/tinypoly/cpu-renderer/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/worker.js"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.ts",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p example",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts",
    "capture:scenes": "node scripts/capture-scenes.js",
    "dev": "tsc -p tsconfig.build.json && vite --config example/vite.config.ts",
    "build:example": "tsc -p tsconfig.build.json && vite build --config example/vite.config.ts",
    "prepublishOnly": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24",
    "@types/three": "^0.185.4",
    "coi-serviceworker": "^0.1.7",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "three": "^0.185.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
